rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function roomData(roomId) { return get(/databases/$(db)/documents/rooms/$(roomId)).data; }
    function isOwner(roomId) { return signedIn() && roomData(roomId).ownerUid == request.auth.uid; }

    // Host = akun dengan email terverifikasi yang tercatat di koleksi hosts (diisi pemilik lewat Console)
    function isHost() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(db)/documents/hosts/$(request.auth.token.email.lower()));
    }

    // Daftar email Host: hanya bisa dibaca pemilik email itu sendiri, ditulis manual lewat Console
    match /hosts/{email} {
      allow get: if signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email;
    }

    // Room: siapa pun yang tahu kodenya boleh membaca (nama acara, kuota, pengaturan)
    match /rooms/{roomId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isHost()
        && roomId.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'date', 'location', 'quota', 'requireApproval', 'guestGallery', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.location is string && request.resource.data.location.size() <= 120
        && request.resource.data.quota is int && request.resource.data.quota >= 1 && request.resource.data.quota <= 100
        && request.resource.data.requireApproval is bool
        && request.resource.data.guestGallery is bool
        && request.resource.data.createdAt == request.time;

      // Foto: Host pemilik room melihat semua; Tamu hanya yang tampil, dan hanya bila galeri dibuka
      match /photos/{photoId} {
        allow read: if isOwner(roomId)
          || (roomData(roomId).guestGallery == true && resource.data.hidden == false);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'fileId', 'createdAt', 'hidden'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.fileId is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.hidden == roomData(roomId).requireApproval;
        // Host hanya boleh mengubah status tampil/sembunyi
        allow update: if isOwner(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden is bool;
      }

      // Kuota Foto tiap Tamu di room ini
      match /users/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= roomData(roomId).quota;
      }
    }
  }
}
